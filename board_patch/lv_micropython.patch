--- a/ports/esp32/boards/GENERIC_S3/sdkconfig.board
+++ b/ports/esp32/boards/GENERIC_S3/sdkconfig.board
@@ -1,12 +1,25 @@
-CONFIG_FLASHMODE_QIO=y
-CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
-CONFIG_ESPTOOLPY_FLASHSIZE_DETECT=y
-CONFIG_ESPTOOLPY_AFTER_NORESET=y
+CONFIG_IDF_TARGET="esp32s3"
+CONFIG_IDF_TARGET_ESP32S3=y
+
+# [核心释放] 禁用 USB-Serial-JTAG 控制台输出，彻底解绑 GPIO19/20
+CONFIG_ESP_CONSOLE_UART_DEFAULT=y
+CONFIG_ESP_CONSOLE_UART=y
+CONFIG_ESP_CONSOLE_UART_NUM=0
+CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
+CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=n
+CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
 
-CONFIG_SPIRAM_MEMTEST=
+# [核心释放] 禁用 USB CDC 与 OTG，防止占用 GPIO19/20
+CONFIG_USB_CDC_ENABLED=n
+CONFIG_USB_OTG_SUPPORTED=n
+CONFIG_TINYUSB=n
 
-CONFIG_ESPTOOLPY_FLASHSIZE_4MB=
+# Flash 基础配置（通用 8MB Flash，80MHz）
 CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
-CONFIG_ESPTOOLPY_FLASHSIZE_16MB=
+CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
+CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
+CONFIG_FLASHMODE_QIO=y
+
+# 增大主应用分区，满足包含 LVGL 8.3 完整库编译体积
 CONFIG_PARTITION_TABLE_CUSTOM=y
 CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-8MiB.csv"

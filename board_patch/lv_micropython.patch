diff --git a/ports/esp32/boards/GENERIC_S3/mpconfigboard.h b/ports/esp32/boards/GENERIC_S3/mpconfigboard.h
index b8f5fb2..49fa6b0 100644
--- a/ports/esp32/boards/GENERIC_S3/mpconfigboard.h
+++ b/ports/esp32/boards/GENERIC_S3/mpconfigboard.h
@@ -1,10 +1,18 @@
-#define MICROPY_HW_BOARD_NAME               "ESP32S3 module"
-#define MICROPY_HW_MCU_NAME                 "ESP32S3"
+#define MODULE_NAME "GENERIC_S3"
+#define MICROPY_HW_BOARD_NAME "ESP32S3 (LVGL8.3-GPIO19/20-Freed)"
+#define MICROPY_HW_MCU_NAME "ESP32S3"
 
-#define MICROPY_PY_MACHINE_DAC              (0)
+#define MICROPY_PY_MACHINE_DAC (0)
 
-// Enable UART REPL for modules that have an external USB-UART and don't use native USB.
-#define MICROPY_HW_ENABLE_UART_REPL         (1)
+// [核心释放] 禁用原生 USB-SERIAL-JTAG 与 USB-OTG 控制器，释放 GPIO19(D-) 和 GPIO20(D+) 为普通GPIO
+#define MICROPY_HW_ENABLE_USB_SERIAL_JTAG (0)
+#define MICROPY_HW_ENABLE_USBDEV          (0)
 
-#define MICROPY_HW_I2C0_SCL                 (9)
-#define MICROPY_HW_I2C0_SDA                 (8)
+// [串口重定向] 强制将 MicroPython REPL 绑定至硬件物理串口 UART0 (由板载第二个独立USB口芯片连接)
+#define MICROPY_HW_ENABLE_UART_REPL       (1)
+#define MICROPY_HW_UART_REPL              (UART_NUM_0)
+#define MICROPY_HW_UART_REPL_BAUD         (115200)
+
+// 标定 ESP32-S3 默认 UART0 物理引脚 (TXD0=GPIO43, RXD0=GPIO44)
+#define MICROPY_HW_UART0_TX               (43)
+#define MICROPY_HW_UART0_RX               (44)
diff --git a/ports/esp32/boards/GENERIC_S3/sdkconfig.board b/ports/esp32/boards/GENERIC_S3/sdkconfig.board
index c9726d4..0de3533 100644
--- a/ports/esp32/boards/GENERIC_S3/sdkconfig.board
+++ b/ports/esp32/boards/GENERIC_S3/sdkconfig.board
@@ -1,12 +1,25 @@
-CONFIG_FLASHMODE_QIO=y
-CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
-CONFIG_ESPTOOLPY_FLASHSIZE_DETECT=y
-CONFIG_ESPTOOLPY_AFTER_NORESET=y
+CONFIG_IDF_TARGET="esp32s3"
+CONFIG_IDF_TARGET_ESP32S3=y
+
+# [核心释放] 禁用 USB-Serial-JTAG 控制台输出，彻底解绑 GPIO19/20
+CONFIG_ESP_CONSOLE_UART_DEFAULT=y
+CONFIG_ESP_CONSOLE_UART=y
+CONFIG_ESP_CONSOLE_UART_NUM=0
+CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
+CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=n
+CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
 
-CONFIG_SPIRAM_MEMTEST=
+# [核心释放] 禁用 USB CDC 与 OTG，防止占用 GPIO19/20
+CONFIG_USB_CDC_ENABLED=n
+CONFIG_USB_OTG_SUPPORTED=n
+CONFIG_TINYUSB=n
 
-CONFIG_ESPTOOLPY_FLASHSIZE_4MB=
+# Flash 基础配置（通用 8MB Flash，80MHz）
 CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
-CONFIG_ESPTOOLPY_FLASHSIZE_16MB=
+CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
+CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
+CONFIG_FLASHMODE_QIO=y
+
+# 增大主应用分区，满足包含 LVGL 8.3 完整库编译体积
 CONFIG_PARTITION_TABLE_CUSTOM=y
 CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-8MiB.csv"

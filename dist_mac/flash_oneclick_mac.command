#!/usr/bin/env bash
# ==============================================================================
# ESP32-S3 LVGL8.3 全自动智能烧录工具 (Mac 用户双击可用)
# 全程自动化: 自动找串口 -> 自动探测硬件(eFuse) -> 自动匹配固件 -> 自动烧录自检
# ==============================================================================
cd "$(dirname "$0")"

clear

if command -v python3 >/dev/null 2>&1; then
    exec python3 flash_auto.py
fi

echo "【错误】未检测到 Python 3 环境，请先安装 Python 3 或在终端中执行。"
read -n 1 -s -r -p "按任意键退出..."
exit 1

diff --git a/ports/esp32/boards/ESP32_GENERIC_S3/mpconfigboard.h b/ports/esp32/boards/ESP32_GENERIC_S3/mpconfigboard.h
index 1111111..2222222 100644
--- a/ports/esp32/boards/ESP32_GENERIC_S3/mpconfigboard.h
+++ b/ports/esp32/boards/ESP32_GENERIC_S3/mpconfigboard.h
@@ -2,3 +2,14 @@
 #define MICROPY_HW_MCU_NAME "ESP32S3"
 
 #define MICROPY_PY_NETWORK_HOSTNAME_DEFAULT "ESP32S3"
+
+// 彻底开放 ESP32-S3 高位引脚 GPIO 47 / 48 (I2C SCL / WS2812 RGB)
+#define MICROPY_HW_ESP32S3_EXTENDED_IO (1)
+
+// 启用底层硬件 PCNT 脉冲计数与四倍频正交编码器支持
+#ifndef MICROPY_PY_MACHINE_ENCODER
+#define MICROPY_PY_MACHINE_ENCODER (1)
+#endif
+#ifndef MICROPY_PY_MACHINE_COUNTER
+#define MICROPY_PY_MACHINE_COUNTER (1)
+#endif
+#ifndef MICROPY_PY_MACHINE_PCNT
+#define MICROPY_PY_MACHINE_PCNT    (1)
+#endif
diff --git a/ports/esp32/boards/ESP32_GENERIC_S3/sdkconfig.board b/ports/esp32/boards/ESP32_GENERIC_S3/sdkconfig.board
index 1111111..2222222 100644
--- a/ports/esp32/boards/ESP32_GENERIC_S3/sdkconfig.board
+++ b/ports/esp32/boards/ESP32_GENERIC_S3/sdkconfig.board
@@ -1,3 +1,11 @@
 CONFIG_IDF_TARGET="esp32s3"
 CONFIG_IDF_TARGET_ESP32S3=y
 
+# 控制台优先使用 USB-Serial-JTAG，释放 GPIO 39~42 传统 JTAG 占用
+CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
+CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
+
+# 确保启用 PCNT 硬件外设支持
+CONFIG_SOC_PCNT_SUPPORTED=y
+
+# 启用多线程与标准网络协议栈
+CONFIG_FREERTOS_UNICORE=n
diff --git a/ports/esp32/esp32_common.cmake b/ports/esp32/esp32_common.cmake
index 1111111..2222222 100644
--- a/ports/esp32/esp32_common.cmake
+++ b/ports/esp32/esp32_common.cmake
@@ -53,6 +53,7 @@ list(APPEND MICROPY_SOURCE_PORT
     machine_i2s.c
     machine_pin.c
     machine_rtc.c
+    machine_encoder.c
     machine_sdcard.c
     machine_timer.c
     machine_touchpad.c
diff --git a/ports/esp32/machine_pin.c b/ports/esp32/machine_pin.c
index 1111111..2222222 100644
--- a/ports/esp32/machine_pin.c
+++ b/ports/esp32/machine_pin.c
@@ -345,6 +345,9 @@ static void machine_pin_isr_handler(void *arg) {
 }
 
+// 确保中断数组与根指针严格覆盖全量 GPIO 0~48 (SOC_GPIO_PIN_COUNT=49)
+// 严禁使用经典 ESP32 的 40 引脚宏，彻底杜绝 GPIO >= 40 注册中断踩踏 VFS 内存
-MP_REGISTER_ROOT_POINTER(mp_obj_t machine_pin_irq_handler[GPIO_PIN_COUNT]);
+MP_REGISTER_ROOT_POINTER(mp_obj_t machine_pin_irq_handler[SOC_GPIO_PIN_COUNT]);
